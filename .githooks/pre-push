#!/bin/bash
# Installé via : git config core.hooksPath .githooks
# Refuse tout push vers main ou dev, puis contrôle les commits réellement nouveaux.
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/dev) echo "push refusé : $remote_ref est protégée"; exit 1 ;;
  esac
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"   # nouvelle branche : tout l'historique atteignable (dépôt petit, couverture maximale)
  else
    range="$remote_sha..$local_sha"
  fi
  "$(git rev-parse --show-toplevel)/scripts/leak-gate.sh" "$range" || { echo "push refusé par leak-gate"; exit 1; }
done
exit 0
